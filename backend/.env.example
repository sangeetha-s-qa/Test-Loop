# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/qa_platform

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
# At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG

REDIS_URL=redis://localhost:6379

# Discovery (Phase 3)
DISCOVERY_ALLOW_LOCAL_FIXTURE=false
DISCOVERY_MAX_PAGES=50
DISCOVERY_MAX_DEPTH=3
DISCOVERY_MAX_DURATION_SECONDS=300
DISCOVERY_MAX_REDIRECTS=5
DISCOVERY_MAX_RESPONSE_BYTES=5000000

# AI (Phase 4). Supported providers: ollama | openai | anthropic | mock
# "ollama" is fully local and contacts no external service.
AI_PROVIDER=ollama
AI_MODEL=qwen2.5:3b-instruct
OLLAMA_BASE_URL=http://localhost:11434
AI_REQUEST_TIMEOUT_MS=900000
AI_STREAM_FIRST_CHUNK_TIMEOUT_MS=600000
AI_STREAM_STALL_TIMEOUT_MS=60000
# Upper bound on the local context window. Ollama defaults to 2048 tokens whatever the model
# supports, and truncates silently; the prompt and the generated output share this window, so it is
# sized per request up to this ceiling. Lower it on a low-memory host - a larger window costs RAM
# for the KV cache - and raise it only if a prompt legitimately needs more room.
AI_MAX_CONTEXT_TOKENS=8192
AI_MAX_PAGES=50
AI_MAX_ELEMENTS_PER_PAGE=100
AI_MAX_TEST_CASES=25
# Only needed when AI_PROVIDER is openai / anthropic.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Automation and execution (Phases 5-6)
AUTOMATION_MAX_STEPS=60
EXECUTION_ARTIFACT_DIR=./artifacts
EXECUTION_MAX_DURATION_SECONDS=300
EXECUTION_STEP_TIMEOUT_MS=15000
EXECUTION_CONCURRENCY=2
EXECUTION_ALLOW_LOCAL_FIXTURE=false

# Human-in-the-loop (Phase 10). A run that hits an OTP or CAPTCHA suspends and asks a person.
# Keep the timeout BELOW the target application's own session timeout.
MANUAL_ACTION_TIMEOUT_SECONDS=600
MANUAL_ACTION_POLL_INTERVAL_MS=2000
MANUAL_ACTION_MAX_EXTENSIONS=2
MANUAL_ACTION_MAX_CONCURRENT=3
MANUAL_ACTION_SWEEP_INTERVAL_MS=60000

# Page audits (Phase 11). Deterministic per-page analysis; no AI provider involved.
AUDIT_MAX_PAGES=20
AUDIT_PAGE_TIMEOUT_MS=30000
AUDIT_CONCURRENCY=2
AUDIT_ALLOW_LOCAL_FIXTURE=false
AUDIT_PERF_LCP_MS=2500
AUDIT_PERF_FCP_MS=1800
AUDIT_PERF_TTFB_MS=800
AUDIT_PERF_TBT_MS=300

# Matrix replay (Phase 12). Cells = browsers x viewports; cost grows multiplicatively.
MATRIX_MAX_CELLS=9

# API inventory and probing (Phase 13). Only idempotent methods are ever replayed.
DISCOVERY_MAX_ENDPOINTS=100
AUDIT_MAX_ENDPOINTS=40
AUDIT_ENDPOINT_TIMEOUT_MS=10000

# Email one-time codes are ARCHIVED (off) by default: sign-up and sign-in use email + password only,
# and forgot-password is hidden. Set to true to restore codes on sign-up, every sign-in, and reset -
# which then also needs the SMTP settings below.
AUTH_EMAIL_OTP_ENABLED=false

# Email (one-time codes for sign-up verification, every sign-in, and password reset).
# Any SMTP service works. Gmail: smtp.gmail.com, port 465 + SMTP_SECURE=true (or 587 + false), and an
# App Password from https://myaccount.google.com/apppasswords - not your normal password.
# Outlook/Office 365: smtp.office365.com, port 587, SMTP_SECURE=false.
# Until SMTP_HOST is set, sign-up, sign-in, and password reset answer EMAIL_NOT_CONFIGURED.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Testloop <no-reply@yourdomain.com>"
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=8
