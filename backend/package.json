{
  "name": "testloop-api",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "worker:discovery": "tsx src/discovery/worker.ts",
    "worker:ai": "tsx src/ai/worker.ts",
    "worker:ai-generation": "tsx src/ai/worker.ts",
    "worker:automation": "tsx src/automation/worker.ts",
    "worker:execution": "tsx src/execution/worker.ts",
    "workers": "concurrently -n discovery,ai,automation,execution,analysis,audit \"npm run worker:discovery\" \"npm run worker:ai-generation\" \"npm run worker:automation\" \"npm run worker:execution\" \"npm run worker:analysis\" \"npm run worker:audit\"",
    "fixture": "tsx src/fixture/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "worker:analysis": "tsx src/analysis/worker.ts",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:status": "prisma migrate status --schema prisma/schema.prisma",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "worker:audit": "tsx src/audit/worker.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "axe-core": "^4.13.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.56.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "nodemailer": "^6.10.1",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.55.0",
    "pngjs": "^7.0.0",
    "zod": "^3.25.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.24",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.0.0",
    "prisma": "^6.7.0",
    "smtp-server": "^3.19.17",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.1.0"
  }
}
